{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "悦听",
  "version": "1.0.0",
  "identifier": "com.local.yueting",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8123",
    "beforeBuildCommand": "node scripts/build-dist.mjs",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "悦听",
        "width": 430,
        "height": 860,
        "minWidth": 400,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "悦听本地音乐播放器",
    "longDescription": "安卓风格的本地音乐播放器，所有数据保存在本机。"
  }
}
