# 依赖（仅测试用，可随时 npm install 还原）
node_modules/

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 编辑器/IDE
.vscode/
.idea/

# 本地工作区个人文件（不入库）
.zcode/
# 个人音乐文件（测试/试听用，不入库）
music/
# exe 发布包（构建产物，npm run app:build 可重新生成；使用说明保留入库）
release/*
!release/使用说明.txt

# ===== Tauri 打包相关 =====
# Rust 编译产物（体积大，可重新生成）
src-tauri/target/
# Tauri 生成的权限 schema
src-tauri/gen/
# 打包用的静态资源副本（由 scripts/build-dist.mjs 生成）
dist/
